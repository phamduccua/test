{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "react": [
        "./src/vendor/react-shim.ts"
      ]
    }
  },
  "include": [
    "src",
    "tests",
    "scripts",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
